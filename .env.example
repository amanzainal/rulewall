# rulewall environment configuration (all optional)
#
# rulewall is a fully offline static scanner. It does NOT require any API keys,
# accounts, or network access to run. These variables only tune behavior.
#
# Copy to .env and edit if you want non-default behavior:
#   cp .env.example .env

# Optional: override the default minimum severity that causes a non-zero exit.
# One of: note | warning | error   (default: warning)
# RULEWALL_FAIL_ON=warning

# Optional: if you ever add an integration that posts results somewhere,
# read its token from the environment here. Never hardcode tokens in code.
# RULEWALL_UPLOAD_TOKEN=replace-me-with-a-real-token
